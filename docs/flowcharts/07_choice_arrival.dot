	path -> drive [label="Cần di chuyển" style=solid]
	drive -> terminal [label="" style=solid]
	terminal -> cleanup [label="Có" style=solid]
	terminal -> reached [label="Không" style=solid]
	reached -> drive [label="Chưa đến" style=solid]
	reached -> due [label="Tới cuối path" style=solid]
	due -> enqueue [label="Clock đạt arrival_due" style=solid]
	drive -> noroute [label="Behavior hiện tại" style=dashed]
	enqueue -> demand [label="" style=solid]
	demand -> observe [label="" style=solid]
	observe -> fifo [label="" style=solid]
